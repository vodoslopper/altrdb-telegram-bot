# altrdb-telegram-bot configuration.
#
# Copy to .env, fill in the token, and never commit the result. Every value
# below is the built-in default unless marked REQUIRED.
#
#   cp .env.example .env && chmod 600 .env

# --- Telegram ---------------------------------------------------------------
# REQUIRED. From @BotFather -> /newbot -> API token.
TELEGRAM_BOT_TOKEN=

# polling (default, needs no inbound port) or webhook.
TELEGRAM_MODE=polling
# Required only when TELEGRAM_MODE=webhook. Must be https:// and must point at
# the path this process serves: https://<host>/telegram/webhook
TELEGRAM_WEBHOOK_URL=
# Required only in webhook mode, at least 16 characters of random data:
#   openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Optional comma-separated allowlist. Empty means "anyone who finds the bot".
# Get your own id from @userinfobot.
ALLOWED_TELEGRAM_USER_IDS=
# Set to true to let the bot work in groups and channels too. Default false:
# private chats only, one subscription per chat.
ALLOW_TELEGRAM_GROUPS=false

# --- ALT RDB ----------------------------------------------------------------
RDB_BASE_URL=https://rdb.altlinux.org/api
# How often each followed branch is polled. Minimum 15s.
POLL_INTERVAL=60s
# How many newest tasks to fetch per branch per poll. The feed is a capped
# current-state view: too small a window can miss transitions, and the bot
# reports that as poll_window_saturated on /healthz and /metrics.
RDB_TASKS_LIMIT=200
# How far back a poll window should reach before it is considered too small.
RDB_OVERLAP_WINDOW=24h
# Maximum number of branches polled at the same time.
RDB_MAX_CONCURRENT_BRANCHES=3
# How often the branch catalogue is refreshed from RDB.
BRANCH_REFRESH_INTERVAL=30m
# How often the packager directory of a followed branch is re-fetched. It is
# only used to validate nicknames and offer suggestions.
MAINTAINER_CACHE_TTL=6h
# Sent as the User-Agent on every RDB request. Leave the default so the ALT
# operators can see what is polling them.
#RDB_USER_AGENT=altrdb-telegram-bot/1.0.0

# HTTP client timeouts for RDB.
HTTP_TIMEOUT=30s
HTTP_CONNECT_TIMEOUT=10s
HTTP_TLS_TIMEOUT=10s

# --- Storage ----------------------------------------------------------------
DATABASE_PATH=/var/lib/altrdb-telegram-bot/bot.db
# How long task snapshots are kept. Older rows are pruned; they are far outside
# the polling window by then.
SNAPSHOT_RETENTION=720h
# Single-instance lease. A second process on the same database refuses to start.
LEASE_TTL=90s
LEASE_HEARTBEAT=30s

# --- Delivery ---------------------------------------------------------------
# How often the outbox is drained.
NOTIFY_INTERVAL=5s
# Transient Telegram failures before a notification is given up on.
NOTIFY_MAX_ATTEMPTS=8
# Minimum gap between two outgoing messages.
NOTIFY_SEND_SPACING=50ms
# States treated as final by the "terminal only" notification mode.
TERMINAL_STATES=DONE,FAILED

# --- Observability ----------------------------------------------------------
# Loopback by default: put a reverse proxy or an SSH tunnel in front of it.
HTTP_LISTEN_ADDR=127.0.0.1:8080
# debug | info | warn | error
LOG_LEVEL=info
# text | json
LOG_FORMAT=text
